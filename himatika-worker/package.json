{
  "name": "himatika-worker",
  "version": "1.0.0",
  "description": "HIMATIKA App — Cloudflare Workers + D1 + Hono.js",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply himatika_db",
    "db:migrate:local": "wrangler d1 migrations apply himatika_db --local",
    "db:seed": "wrangler d1 execute himatika_db --file=migrations/seed.sql --local",
    "db:studio": "wrangler d1 execute himatika_db --local --command=\"SELECT name FROM sqlite_master WHERE type='table'\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.165.0"
  }
}
